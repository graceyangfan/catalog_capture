# Copy to env/binance-spot-sbe.toml, replace values, then chmod 600.
# This must be a Binance Ed25519 API key and matching private key (base64 or PEM),
# with access to the Spot SBE market-data stream. Trade permission is not required.
api_key = "replace-with-binance-ed25519-api-key"
private_key = '''
-----BEGIN PRIVATE KEY-----
replace-with-binance-ed25519-private-key
-----END PRIVATE KEY-----
'''
