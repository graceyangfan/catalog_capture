# Optional venue credentials for catalog-capture-cli (never commit real secrets).
# See docs/how_to/credentials.md
#
# DEFAULT = public market data. Fake/placeholder keys are ignored.
# Authenticated clients require BOTH:
#   1) CAPTURE_USE_VENUE_CREDENTIALS=1
#   2) a complete non-placeholder key pair

# CAPTURE_USE_VENUE_CREDENTIALS=0

# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# DERIBIT_API_KEY=
# DERIBIT_API_SECRET=

# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=

# HYPERLIQUID_PRIVATE_KEY=

# Optional: pin label written into metadata/capture_run.json
# NAUTILUS_TRADER_REF=a7159b484e816a8b73388ff58db71de454253222
