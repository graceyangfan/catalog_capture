# Copy to a gitignored local file, for example `.env.predict-testnet`.
# Use a dedicated, disposable BNB Testnet EOA. Never use a production wallet.
PREDICT_TESTNET_PRIVATE_KEY=

# Optional guard: the probe fails if this address does not match the private key.
PREDICT_TESTNET_WALLET_ADDRESS=

# Optional on Testnet. Use the key name already used by your deployment if preferred:
# X_API_KEY=...
PREDICT_API_KEY=

# Optional overrides; defaults are the current official endpoints.
PREDICT_TESTNET_API_URL=https://api-testnet.predict.fun
PREDICT_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
