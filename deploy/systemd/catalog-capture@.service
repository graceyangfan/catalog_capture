[Unit]
Description=Catalog Capture (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=catalog-capture
Group=catalog-capture
WorkingDirectory=/opt/catalog-capture
Environment=RUSTUP_TOOLCHAIN=1.97.1
Environment=CATALOG_CAPTURE_LOG_DIR=/var/log/catalog-capture
Environment=CATALOG_CAPTURE_CONFIG=/opt/catalog-capture/examples/operator/capture.%i-unattended.toml
ExecStart=/opt/catalog-capture/scripts/run-capture-service.sh --config ${CATALOG_CAPTURE_CONFIG} --release
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
