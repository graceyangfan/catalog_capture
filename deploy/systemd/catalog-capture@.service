[Unit]
Description=Nautilus catalog capture (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nautilus
Group=nautilus
WorkingDirectory=/opt/nautilus_catalog_capture
Environment=RUSTUP_TOOLCHAIN=1.96.0
Environment=CATALOG_CAPTURE_LOG_DIR=/var/log/nautilus-catalog-capture
Environment=CATALOG_CAPTURE_CONFIG=/opt/nautilus_catalog_capture/examples/operator/capture.%i-unattended.toml
ExecStart=/opt/nautilus_catalog_capture/scripts/run-capture-service.sh --config ${CATALOG_CAPTURE_CONFIG} --release
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target